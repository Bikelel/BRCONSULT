<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_prestation_conservation_state_list" model="ir.ui.view">
            <field name="name">prestation.conservation.state.list</field>
            <field name="model">prestation.conservation.state</field>
            <field name="arch" type="xml">
                <list string="Etat de conservation" editable="top">
                    <field name="name"/>
                    <field name="inspection_type"/>
                    <field name="installation_type" required="inspection_type == 'levage'" readonly="inspection_type == 'echafaudage'"/>
                </list>
            </field>
        </record>

        <record id="action_prestation_conservation_state" model="ir.actions.act_window">
            <field name="name">Etat de conservation</field>
            <field name="res_model">prestation.conservation.state</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem name="Liste d'état de conservation" id="br_consult_menu_prestation_conservation_state" parent="br_consult_settings_general_data_menu" sequence="50" action="action_prestation_conservation_state"/>

  </data>
</odoo>